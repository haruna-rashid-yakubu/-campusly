# Neon Postgres connection string (pooled), e.g. postgres://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# NextAuth — generate with `npx auth secret`
AUTH_SECRET=

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Authorized redirect URI: <your-origin>/api/auth/callback/google
# Production origin/redirect must be registered in Google Cloud for https://www.mycampusly.fr.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: Expo access token if "enhanced push security" is on for the project
EXPO_ACCESS_TOKEN=

# Comma-separated emails granted the admin role on first sign-in
ADMIN_EMAILS=

# Cloudflare R2 — the papers and every file people send (lib/envois), through
# R2's S3 API. dash.cloudflare.com > R2 > Manage API tokens.
R2_ACCOUNT_ID=
R2_BUCKET=campusly
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Sent as a bearer token by the cron service (docker-compose.yml); any long random string.
CRON_SECRET=

# The AI tutor and the Assistant.
DEEPSEEK_API_KEY=

# Web Push (browser notifications) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@campusly.app

# Numéro WhatsApp du service de pressing, au format international sans + ni
# espaces (ex. 237600000000). Non renseigné, l'écran Pressing affiche un avis
# au lieu d'un bouton qui ouvrirait une conversation avec personne.
NEXT_PUBLIC_PRESSING_WHATSAPP=
